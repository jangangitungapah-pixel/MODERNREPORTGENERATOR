rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(userId) {
      return signedIn() &&
        request.auth.uid == userId;
    }

    match /users/{userId}/workspaces/{workspaceId} {
      allow read, create, update, delete:
        if ownsUser(userId);
    }

    match /users/{userId}/incidents/{incidentId} {
      allow read, create, update, delete:
        if ownsUser(userId);
    }

    match /users/{userId}/snapshots/{snapshotId} {
      allow read, create, delete:
        if ownsUser(userId);

      // Recovery snapshots are immutable once created.
      allow update: if false;
    }

    match /users/{userId}/impactBoards/{boardId} {
      allow read, create, update, delete:
        if ownsUser(userId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
