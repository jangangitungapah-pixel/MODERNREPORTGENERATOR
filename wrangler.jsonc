{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "reportos",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "REPORTOS_ENV": "production"
  }
}
