.launcher {
  position: fixed;
  right: 20px;
  bottom: 86px;
  z-index: 150;
  display: grid;
  grid-template-columns: 34px minmax(0, 1fr) 16px;
  align-items: center;
  gap: 9px;
  min-width: 214px;
  min-height: 50px;
  padding: 7px 10px 7px 8px;
  border: 1px solid rgba(92, 80, 176, 0.14);
  border-radius: 16px;
  color: #4d5367;
  background:
    radial-gradient(circle at 8% 0%, rgba(112, 89, 241, 0.13), transparent 78px),
    rgba(255, 255, 255, 0.88);
  box-shadow:
    0 18px 45px rgba(42, 48, 79, 0.13),
    inset 0 1px 0 rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(24px) saturate(1.18);
  -webkit-backdrop-filter: blur(24px) saturate(1.18);
  cursor: pointer;
  transition:
    transform 160ms ease,
    box-shadow 160ms ease,
    border-color 160ms ease;
}

.launcher:hover {
  transform: translateY(-1px);
  border-color: rgba(103, 84, 234, 0.23);
  box-shadow:
    0 22px 52px rgba(42, 48, 79, 0.16),
    inset 0 1px 0 rgba(255, 255, 255, 0.95);
}

.launcher[data-ready='true'] {
  border-color: rgba(35, 158, 114, 0.17);
}

.launcherIcon {
  display: grid;
  width: 34px;
  height: 34px;
  place-items: center;
  border: 1px solid rgba(103, 84, 234, 0.12);
  border-radius: 11px;
  color: #6652e8;
  background: rgba(103, 84, 234, 0.08);
}

.launcherCopy {
  display: flex;
  min-width: 0;
  flex-direction: column;
  align-items: flex-start;
}

.launcherCopy strong {
  color: #42495c;
  font-size: 11.5px;
  font-weight: 780;
  letter-spacing: -0.01em;
}

.launcherCopy small {
  margin-top: 2px;
  color: #8991a2;
  font-size: 10px;
  font-weight: 580;
}

.launcherChevron,
.launcherChevronOpen {
  color: #8d86b8;
  transition: transform 160ms ease;
}

.launcherChevronOpen {
  transform: rotate(90deg);
}

.panel {
  position: fixed;
  right: 20px;
  bottom: 144px;
  z-index: 151;
  width: min(430px, calc(100vw - 32px));
  max-height: min(70vh, 720px);
  overflow: hidden;
  border: 1px solid rgba(80, 78, 108, 0.11);
  border-radius: 22px;
  background:
    radial-gradient(circle at 100% 0%, rgba(109, 87, 239, 0.1), transparent 210px),
    linear-gradient(145deg, rgba(255, 255, 255, 0.97), rgba(247, 248, 253, 0.94));
  box-shadow:
    0 30px 80px rgba(38, 44, 73, 0.18),
    inset 0 1px 0 rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(28px) saturate(1.14);
  -webkit-backdrop-filter: blur(28px) saturate(1.14);
}

.panelHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 15px 16px 12px;
  border-bottom: 1px solid rgba(65, 72, 101, 0.07);
}

.panelTitle {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 10px;
  color: #6451db;
}

.panelTitle > span {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.panelTitle strong {
  color: #343a4d;
  font-size: 13px;
  font-weight: 800;
}

.panelTitle small {
  margin-top: 2px;
  color: #858d9e;
  font-size: 10.5px;
  line-height: 1.35;
}

.iconButton {
  display: grid;
  width: 32px;
  height: 32px;
  flex: 0 0 auto;
  place-items: center;
  border: 1px solid rgba(70, 77, 103, 0.09);
  border-radius: 10px;
  color: #747d91;
  background: rgba(255, 255, 255, 0.74);
  cursor: pointer;
}

.iconButton:disabled {
  cursor: default;
  opacity: 0.5;
}

.tabs {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 5px;
  padding: 8px 10px;
  border-bottom: 1px solid rgba(65, 72, 101, 0.06);
  background: rgba(247, 248, 252, 0.58);
}

.tabs button {
  min-height: 34px;
  border: 1px solid transparent;
  border-radius: 10px;
  color: #798194;
  background: transparent;
  font-size: 10.5px;
  font-weight: 730;
  cursor: pointer;
}

.tabs button[data-active='true'] {
  border-color: rgba(103, 84, 234, 0.11);
  color: #5e4ad0;
  background: rgba(103, 84, 234, 0.07);
}

.tabs button span {
  display: inline-grid;
  min-width: 18px;
  height: 18px;
  margin-left: 6px;
  place-items: center;
  border-radius: 999px;
  background: rgba(103, 84, 234, 0.1);
  font-size: 9px;
}

.panelBody {
  max-height: min(55vh, 580px);
  overflow: auto;
  padding: 12px;
}

.scoreGrid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 7px;
  margin-bottom: 10px;
}

.scoreGrid article {
  display: flex;
  min-width: 0;
  min-height: 58px;
  align-items: center;
  gap: 8px;
  padding: 9px;
  border: 1px solid rgba(65, 72, 101, 0.075);
  border-radius: 12px;
  color: #6a58d9;
  background: rgba(255, 255, 255, 0.75);
}

.scoreGrid article span {
  display: flex;
  flex-direction: column;
}

.scoreGrid small {
  color: #9198a8;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.055em;
}

.scoreGrid strong {
  margin-top: 2px;
  color: #3e4659;
  font-size: 14px;
  font-weight: 820;
}

.readinessList,
.templateList {
  display: grid;
  gap: 7px;
}

.readinessItem {
  display: grid;
  grid-template-columns: 8px minmax(0, 1fr) 16px;
  gap: 9px;
  align-items: center;
  width: 100%;
  padding: 10px;
  border: 1px solid rgba(65, 72, 101, 0.075);
  border-radius: 12px;
  text-align: left;
  color: #6d7588;
  background: rgba(255, 255, 255, 0.68);
  cursor: pointer;
}

.readinessItem[data-severity='blocker'] {
  border-color: rgba(201, 81, 81, 0.13);
  background: rgba(201, 81, 81, 0.035);
}

.readinessDot {
  width: 7px;
  height: 7px;
  border-radius: 999px;
  background: #c7862e;
  box-shadow: 0 0 0 4px rgba(199, 134, 46, 0.08);
}

.readinessItem[data-severity='blocker'] .readinessDot {
  background: #c95151;
  box-shadow: 0 0 0 4px rgba(201, 81, 81, 0.08);
}

.readinessItem > span:nth-child(2) {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.readinessItem strong,
.readyState strong,
.cloudStatus strong,
.emptyTemplateState strong,
.templateCopy strong,
.actionGrid strong {
  color: #485065;
  font-size: 11px;
  font-weight: 780;
}

.readinessItem small,
.readyState small,
.cloudStatus small,
.emptyTemplateState small,
.templateCopy small,
.actionGrid small {
  margin-top: 2px;
  color: #8a92a3;
  font-size: 10px;
  line-height: 1.4;
}

.readyState,
.emptyTemplateState {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 14px;
  border: 1px solid rgba(35, 158, 114, 0.12);
  border-radius: 13px;
  color: #239e72;
  background: rgba(35, 158, 114, 0.045);
}

.readyState > span,
.emptyTemplateState {
  min-width: 0;
}

.readyState > span {
  display: flex;
  flex-direction: column;
}

.cloudStatus {
  display: grid;
  grid-template-columns: 32px minmax(0, 1fr) 32px;
  align-items: center;
  gap: 9px;
  margin-bottom: 9px;
  padding: 9px;
  border: 1px solid rgba(103, 84, 234, 0.08);
  border-radius: 12px;
  color: #6754ea;
  background: rgba(103, 84, 234, 0.045);
}

.cloudStatus > span {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.templateSaveRow {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 7px;
  margin-bottom: 10px;
}

.templateSaveRow input {
  min-width: 0;
  min-height: 38px;
  padding: 0 11px;
  border: 1px solid rgba(65, 72, 101, 0.1);
  border-radius: 11px;
  color: #465064;
  background: rgba(255, 255, 255, 0.85);
  font: inherit;
  font-size: 11px;
}

.templateSaveRow button {
  display: inline-flex;
  min-height: 38px;
  align-items: center;
  gap: 6px;
  padding: 0 11px;
  border: 0;
  border-radius: 11px;
  color: #fff;
  background: linear-gradient(135deg, #745ff0, #5a43df);
  font-size: 10.5px;
  font-weight: 760;
  cursor: pointer;
}

.templateSaveRow button:disabled {
  cursor: default;
  opacity: 0.52;
}

.templateItem {
  display: grid;
  grid-template-columns: 34px minmax(0, 1fr) auto;
  gap: 9px;
  align-items: center;
  padding: 9px;
  border: 1px solid rgba(65, 72, 101, 0.075);
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.7);
}

.templateIcon {
  display: grid;
  width: 34px;
  height: 34px;
  place-items: center;
  border-radius: 10px;
  color: #6652df;
  background: rgba(103, 84, 234, 0.07);
}

.templateCopy {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.templateCopy strong {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.templateActions {
  display: flex;
  align-items: center;
  gap: 4px;
}

.templateActions button {
  min-height: 30px;
  padding: 0 8px;
  border: 1px solid rgba(65, 72, 101, 0.09);
  border-radius: 9px;
  color: #626b7f;
  background: rgba(250, 250, 253, 0.9);
  font-size: 9.5px;
  font-weight: 700;
  cursor: pointer;
}

.templateActions .deleteTemplate {
  width: 30px;
  padding: 0;
  color: #b84d4d;
}

.actionGrid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 7px;
}

.actionGrid > button {
  display: flex;
  min-height: 66px;
  align-items: center;
  gap: 9px;
  padding: 10px;
  border: 1px solid rgba(65, 72, 101, 0.075);
  border-radius: 12px;
  text-align: left;
  color: #6652df;
  background: rgba(255, 255, 255, 0.72);
  cursor: pointer;
}

.actionGrid > button span {
  display: flex;
  flex-direction: column;
}

.jumpGrid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 5px;
  margin-top: 8px;
}

.jumpGrid button {
  min-height: 32px;
  border: 1px solid rgba(65, 72, 101, 0.075);
  border-radius: 9px;
  color: #697287;
  background: rgba(249, 250, 253, 0.84);
  font-size: 9.5px;
  font-weight: 700;
  cursor: pointer;
}

.paletteBackdrop {
  position: fixed;
  inset: 0;
  z-index: 400;
  display: grid;
  place-items: start center;
  padding-top: min(17vh, 180px);
  background: rgba(30, 35, 55, 0.22);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

.palette {
  width: min(620px, calc(100vw - 28px));
  overflow: hidden;
  border: 1px solid rgba(73, 72, 104, 0.13);
  border-radius: 20px;
  background: rgba(252, 252, 255, 0.97);
  box-shadow: 0 34px 100px rgba(31, 37, 66, 0.24);
}

.paletteSearch {
  display: grid;
  grid-template-columns: 20px minmax(0, 1fr) auto;
  align-items: center;
  gap: 10px;
  min-height: 58px;
  padding: 0 14px;
  border-bottom: 1px solid rgba(65, 72, 101, 0.08);
  color: #7665db;
}

.paletteSearch input {
  min-width: 0;
  border: 0;
  outline: 0;
  color: #3f475b;
  background: transparent;
  font: inherit;
  font-size: 13px;
}

.paletteSearch kbd {
  padding: 4px 6px;
  border: 1px solid rgba(65, 72, 101, 0.09);
  border-radius: 7px;
  color: #9299a8;
  background: #f6f7fa;
  font-size: 9px;
}

.paletteList {
  max-height: 420px;
  overflow: auto;
  padding: 8px;
}

.paletteList button {
  display: grid;
  grid-template-columns: 28px minmax(0, 1fr) 16px;
  width: 100%;
  align-items: center;
  gap: 9px;
  padding: 10px;
  border: 1px solid transparent;
  border-radius: 11px;
  text-align: left;
  color: #6754ea;
  background: transparent;
  cursor: pointer;
}

.paletteList button:hover,
.paletteList button:focus-visible {
  border-color: rgba(103, 84, 234, 0.1);
  background: rgba(103, 84, 234, 0.055);
  outline: none;
}

.paletteList button span {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.paletteList strong {
  color: #454d61;
  font-size: 11.5px;
  font-weight: 760;
}

.paletteList small {
  margin-top: 2px;
  color: #8b93a4;
  font-size: 10px;
}

.paletteEmpty {
  padding: 24px;
  text-align: center;
  color: #8a92a3;
  font-size: 11px;
}

@media (max-width: 860px) {
  .launcher {
    right: 12px;
    bottom: 84px;
    min-width: 178px;
  }

  .panel {
    right: 10px;
    bottom: 142px;
    width: calc(100vw - 20px);
    max-height: 68vh;
  }

  .scoreGrid {
    grid-template-columns: 1fr 1fr;
  }

  .scoreGrid article:last-child {
    grid-column: 1 / -1;
  }

  .templateSaveRow,
  .templateItem {
    grid-template-columns: 1fr;
  }

  .templateActions {
    justify-content: flex-start;
  }

  .actionGrid,
  .jumpGrid {
    grid-template-columns: 1fr 1fr;
  }

  .templateSaveRow input,
  .paletteSearch input {
    font-size: 16px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .launcher,
  .launcherChevron,
  .launcherChevronOpen {
    transition: none;
  }

  .launcher:hover {
    transform: none;
  }
}
